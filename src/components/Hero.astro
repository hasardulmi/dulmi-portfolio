---
import { profile } from "../data/profile";
import TestRunPanel from "./TestRunPanel.astro";

const { hero, contact } = profile;
// Icon: Lucide "download" (ISC licence), inlined.
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero-inner">
    <div class="hero-text">
      <p class="tag">
        <span class="tag-dot" aria-hidden="true"></span>
        {hero.tag}
      </p>

      <h1 id="hero-title">{profile.name}</h1>

      <p class="role">{hero.roleLine}</p>

      <p class="intro">{hero.intro}</p>

      <p class="meta">
        <span>{profile.location}</span>
        <span class="sep" aria-hidden="true">
          ·
        </span>
        <span>{hero.degreeLine}</span>
      </p>

      <div class="actions">
        <a class="btn btn-primary" href="#contact">
          Get in touch
        </a>
        <a class="btn btn-secondary" href={profile.cvUrl} download>
          <svg
            viewBox="0 0 24 24"
            width="18"
            height="18"
            aria-hidden="true"
            focusable="false"
          >
            <path d="M12 15V3M7 10l5 5 5-5M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
          </svg>
          Download CV (PDF)
        </a>
        <a class="btn btn-secondary" href={contact.linkedin}>
          LinkedIn<span class="sr-only"> profile</span>
        </a>
        <a class="btn btn-secondary" href={contact.github}>
          GitHub<span class="sr-only"> profile</span>
        </a>
      </div>
    </div>

    <div class="hero-panel">
      <TestRunPanel />
    </div>
  </div>
</section>

<style>
  .hero {
    background-color: var(--panel);
    border-bottom: 1px solid var(--rule);
  }

  .hero-inner {
    display: grid;
    gap: 36px;
    max-width: 1240px;
    margin-inline: auto;
    padding: clamp(36px, 5vw, 72px) max(5vw, 16px);
  }

  @media (min-width: 860px) {
    .hero-inner {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
      align-items: center;
      gap: clamp(40px, 5vw, 72px);
    }
  }

  .tag {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin: 0 0 20px;
    padding: 4px 12px;
    border: 1.5px solid var(--red);
    border-radius: 999px;
    background-color: var(--bg);
    color: var(--ink);
    font-size: 0.875rem; /* 14px */
    font-weight: 600;
  }

  .tag-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: var(--red);
  }

  h1 {
    margin: 0;
  }

  .role {
    margin: 14px 0 0;
    font-size: 1.1875rem; /* 19px */
    font-weight: 600;
    line-height: 1.35;
  }

  .intro {
    margin: 16px 0 0;
  }

  .meta {
    margin: 12px 0 0;
    color: var(--mute);
    font-size: 0.9375rem; /* 15px */
  }

  .sep {
    margin-inline: 0.35em;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 28px;
  }

  /* On narrow screens wrapped buttons fill their row. */
  @media (max-width: 859.98px) {
    .actions .btn {
      flex: 1 1 auto;
    }
  }

  /* Phones: two full-width main actions, then LinkedIn + GitHub side by side. */
  @media (max-width: 519.98px) {
    .actions {
      display: grid;
      grid-template-columns: 1fr 1fr;
    }

    .actions .btn:nth-child(-n + 2) {
      grid-column: 1 / -1;
    }
  }
</style>
