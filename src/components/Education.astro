---
import { profile } from "../data/profile";
import Icon from "./Icon.astro";
import BugButton from "./BugButton.astro";
---

<section id="education" class="section alt" aria-labelledby="education-title">
  <BugButton section="education" position="top:60px;left:12%" />
  <div class="wrap">
    <div class="head rv">
      <span class="eyebrow">Education &amp; certifications</span>
      <h2 id="education-title">
        Always <span class="hl">learning</span>
      </h2>
    </div>

    <div class="edu">
      <div>
        <div class="colh rv">
          <span class="ic">
            <Icon name="cap" />
          </span>
          <h3>Education</h3>
        </div>
        <div class="tl" data-seen>
          <div class="fill" aria-hidden="true"></div>
          <ol>
            {profile.education.map((e, i) => (
              <li
                class:list={["ev card rv", { now: e.current }]}
                style={`--d:${i * 0.1}s`}
              >
                <div class="top">
                  <h4>{e.qualification}</h4>
                  <span class="yr tabular">{e.dates}</span>
                </div>
                <p>
                  {e.detail && e.current
                    ? `${e.institution} · ${e.detail}`
                    : e.detail
                      ? `${e.detail} · ${e.institution}`
                      : e.institution}
                </p>
                {e.badge && <span class="badge">{e.badge}</span>}
              </li>
            ))}
          </ol>
        </div>
      </div>

      <div>
        <div class="colh rv">
          <span class="ic">
            <Icon name="award" />
          </span>
          <h3>Certifications</h3>
        </div>
        {profile.certifications.map((c, i) => (
          <a class="cert card rv" style={`--d:${i * 0.1}s`} href={c.url}>
            <span class="prov">
              {c.provider}
              <span class="seal">
                <Icon name="verified" />
                Certificate
              </span>
            </span>
            <h4>{c.name}</h4>
            <p>{c.description}</p>
            <em>
              View certificate <span aria-hidden="true">→</span>
            </em>
          </a>
        ))}
        <div class="lang card rv" style="--d:.2s">
          <div class="colh">
            <span class="ic">
              <Icon name="globe" />
            </span>
            <h3>Languages</h3>
          </div>
          <dl>
            {profile.languages.map((l) => (
              <div class="row">
                <dt>{l.name}</dt>
                <dd>{l.level}</dd>
              </div>
            ))}
          </dl>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .edu {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    gap: 32px;
    align-items: start;
  }

  .colh {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 22px;
  }

  .colh h3 {
    font-size: 21px;
  }

  .ic {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: var(--g2);
    color: var(--g);
  }

  .tl {
    position: relative;
    padding-left: 34px;
  }

  .tl::before,
  .fill {
    content: "";
    position: absolute;
    top: 6px;
    left: 10px;
    width: 2px;
    height: calc(100% - 12px);
    background: var(--line);
  }

  .fill {
    background: var(--g);
  }

  :global(.js) .fill {
    transform: scaleY(0);
    transform-origin: top;
    transition: transform 1.4s ease;
  }

  :global(.js) .tl:global(.seen) .fill {
    transform: scaleY(1);
  }

  ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .ev {
    position: relative;
    margin-bottom: 14px;
    padding: 18px 20px;
    border-radius: 18px;
  }

  .ev::before {
    content: "";
    position: absolute;
    top: 22px;
    left: -30px;
    width: 14px;
    height: 14px;
    border: 3px solid var(--g);
    border-radius: 50%;
    background: var(--bg);
  }

  .ev.now::before {
    background: var(--g);
    box-shadow: 0 0 0 6px color-mix(in srgb, var(--g) 22%, transparent);
  }

  .top {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 4px 12px;
  }

  h4 {
    margin: 0;
    font: 600 18px / 1.2 var(--font-head-stack);
  }

  .yr {
    color: var(--g);
    font-size: 14px;
    font-weight: 600;
    white-space: nowrap;
  }

  .ev p {
    margin: 4px 0 0;
    color: var(--mute);
    font-size: 15px;
  }

  .badge {
    display: inline-flex;
    margin-top: 10px;
    padding: 3px 10px;
    border-radius: 999px;
    background: var(--g2);
    color: var(--g);
    font-size: 13px;
    font-weight: 600;
  }

  .cert {
    position: relative;
    display: block;
    margin-bottom: 16px;
    padding: 22px;
    overflow: hidden;
    border-radius: 18px;
    color: var(--ink);
    text-decoration: none;
    transition:
      transform 0.25s,
      border-color 0.25s,
      opacity 0.7s;
  }

  .cert:hover {
    border-color: var(--g);
    transform: translateY(-4px);
  }

  .cert::after {
    content: "";
    position: absolute;
    top: 0;
    left: -60%;
    width: 40%;
    height: 100%;
    background: linear-gradient(
      100deg,
      transparent,
      color-mix(in srgb, var(--g) 14%, transparent),
      transparent
    );
    transform: skewX(-18deg);
    transition: left 0.7s;
    pointer-events: none;
  }

  .cert:hover::after {
    left: 120%;
  }

  .prov {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 8px;
    color: var(--mute);
    font-size: 13px;
  }

  .seal {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    margin-left: auto;
    color: var(--g);
    font-weight: 600;
  }

  .seal :global(.i) {
    width: 16px;
    height: 16px;
  }

  .cert p {
    margin: 6px 0 10px;
    color: var(--mute);
    font-size: 14px;
  }

  .cert em {
    color: var(--g);
    font-size: 14px;
    font-style: normal;
    font-weight: 600;
  }

  .lang {
    padding: 20px 22px;
    border-radius: 18px;
  }

  .lang .colh {
    margin-bottom: 10px;
  }

  dl {
    margin: 0;
  }

  .row {
    display: flex;
    justify-content: space-between;
    gap: 10px;
    padding: 8px 0;
    border-top: 1px solid var(--line);
  }

  .row:first-child {
    border-top: 0;
  }

  dt {
    font-weight: 700;
  }

  dd {
    margin: 0;
    color: var(--mute);
    font-size: 14px;
    text-align: right;
  }

  @media (max-width: 860px) {
    .edu {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
