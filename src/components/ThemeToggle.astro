---
// Light/dark theme toggle. The initial data-theme is set by the inline script
// in BaseLayout; this component only switches and saves it.
import Icon from "./Icon.astro";
---

<button
  type="button"
  class="theme-toggle"
  aria-label="Dark theme"
  aria-pressed="false"
  data-theme-toggle
>
  <Icon name="moon" class="icon-moon" />
  <Icon name="sun" class="icon-sun" />
</button>

<script>
  const STORAGE_KEY = "theme";
  type Theme = "light" | "dark";

  const root = document.documentElement;
  const button = document.querySelector<HTMLButtonElement>(
    "[data-theme-toggle]",
  );

  const current = (): Theme =>
    root.dataset.theme === "dark" ? "dark" : "light";

  const readSaved = (): Theme | null => {
    try {
      const value = localStorage.getItem(STORAGE_KEY);
      return value === "light" || value === "dark" ? value : null;
    } catch {
      return null;
    }
  };

  const sync = () => {
    button?.setAttribute("aria-pressed", String(current() === "dark"));
  };

  button?.addEventListener("click", () => {
    const next: Theme = current() === "dark" ? "light" : "dark";
    root.dataset.theme = next;
    try {
      localStorage.setItem(STORAGE_KEY, next);
    } catch {
      // Storage blocked (private mode, etc.): the switch still works for this visit.
    }
    sync();
  });

  // Follow live system changes until the visitor makes a choice.
  window
    .matchMedia("(prefers-color-scheme: dark)")
    .addEventListener("change", (event) => {
      if (readSaved()) return;
      root.dataset.theme = event.matches ? "dark" : "light";
      sync();
    });

  sync();
</script>

<style>
  .theme-toggle {
    /* Hidden without JS (it could not work); BaseLayout adds .js before paint. */
    display: none;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: var(--bg2);
    color: var(--ink);
    cursor: pointer;
    transition:
      border-color 0.2s,
      color 0.2s;
  }

  :global(.js) .theme-toggle {
    display: grid;
  }

  .theme-toggle:hover {
    border-color: var(--g);
    color: var(--g);
  }

  .theme-toggle :global(.i) {
    width: 20px;
    height: 20px;
  }

  /*
   * Moon in light theme, sun in dark theme. Driven by <html data-theme> so the
   * right icon shows from first paint, before this module script runs.
   */
  .theme-toggle :global(.icon-sun),
  :global([data-theme="dark"]) .theme-toggle :global(.icon-moon) {
    display: none;
  }

  :global([data-theme="dark"]) .theme-toggle :global(.icon-sun) {
    display: block;
  }
</style>
