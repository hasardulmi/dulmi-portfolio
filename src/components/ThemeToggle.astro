---
// Light/dark theme toggle. The initial data-theme is set by the inline script
// in BaseLayout; this component only switches and saves it.
// Icons: Lucide "sun" and "moon" (ISC licence), inlined.
---

<button
  type="button"
  class="theme-toggle"
  aria-label="Dark theme"
  aria-pressed="false"
  data-theme-toggle
>
  <svg
    class="icon icon-moon"
    viewBox="0 0 24 24"
    width="20"
    height="20"
    aria-hidden="true"
    focusable="false"
  >
    <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
  </svg>
  <svg
    class="icon icon-sun"
    viewBox="0 0 24 24"
    width="20"
    height="20"
    aria-hidden="true"
    focusable="false"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
  </svg>
</button>

<script>
  const STORAGE_KEY = "theme";
  type Theme = "light" | "dark";

  const root = document.documentElement;
  const button = document.querySelector<HTMLButtonElement>(
    "[data-theme-toggle]",
  );

  const current = (): Theme =>
    root.dataset.theme === "dark" ? "dark" : "light";

  const readSaved = (): Theme | null => {
    try {
      const value = localStorage.getItem(STORAGE_KEY);
      return value === "light" || value === "dark" ? value : null;
    } catch {
      return null;
    }
  };

  const sync = () => {
    button?.setAttribute("aria-pressed", String(current() === "dark"));
  };

  button?.addEventListener("click", () => {
    const next: Theme = current() === "dark" ? "light" : "dark";
    root.dataset.theme = next;
    try {
      localStorage.setItem(STORAGE_KEY, next);
    } catch {
      // Storage blocked (private mode, etc.): the switch still works for this visit.
    }
    sync();
  });

  // Follow live system changes until the visitor makes a choice.
  window
    .matchMedia("(prefers-color-scheme: dark)")
    .addEventListener("change", (event) => {
      if (readSaved()) return;
      root.dataset.theme = event.matches ? "dark" : "light";
      sync();
    });

  sync();
</script>

<style>
  .theme-toggle {
    /* Hidden without JS (it could not work); BaseLayout adds .js before paint. */
    display: none;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 44px;
    padding: 0;
    border: 1.5px solid var(--rule);
    border-radius: 8px;
    background: transparent;
    color: var(--ink);
    cursor: pointer;
  }

  :global(.js) .theme-toggle {
    display: inline-flex;
  }

  .theme-toggle:hover {
    border-color: var(--ink);
  }

  .icon {
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /*
   * Moon in light theme, sun in dark theme. Driven by <html data-theme> so the
   * right icon shows from first paint, before this module script runs.
   */
  .icon-sun,
  :global([data-theme="dark"]) .icon-moon {
    display: none;
  }

  :global([data-theme="dark"]) .icon-sun {
    display: block;
  }
</style>
