---
import { profile } from "../data/profile";
import Icon from "./Icon.astro";
import BugButton from "./BugButton.astro";

const id = (i: number) => `skills-tab-${i}`;
const panelId = (i: number) => `skills-panel-${i}`;
---

<section id="skills" class="section alt" aria-labelledby="skills-title">
  <BugButton section="skills" position="top:90px;right:8%" />
  <div class="wrap">
    <div class="head rv">
      <span class="eyebrow">Technical skills</span>
      <h2 id="skills-title">
        What I <span class="hl">work with</span>
      </h2>
      <p class="sub">Pick a group to see the skills from my CV.</p>
    </div>

    {/* Without JS the tab list is hidden and every panel shows in turn. */}
    <div
      class="tabs js-only rv"
      role="tablist"
      aria-label="Technical skill groups"
      data-tabs
    >
      {profile.skills.map((g, i) => (
        <button
          type="button"
          role="tab"
          id={id(i)}
          aria-controls={panelId(i)}
          aria-selected={i === 0 ? "true" : "false"}
          tabindex={i === 0 ? 0 : -1}
        >
          <Icon name={g.icon} />
          {g.tab}
        </button>
      ))}
    </div>

    {profile.skills.map((g, i) => (
      <div
        class="panel card rv"
        role="tabpanel"
        id={panelId(i)}
        aria-labelledby={id(i)}
        tabindex="0"
        data-inactive={i === 0 ? undefined : ""}
      >
        <div>
          <div class="big">
            <Icon name={g.icon} />
          </div>
          <h3>{g.title}</h3>
          <p>{g.description}</p>
        </div>
        <ul class="cloud">
          {g.items.map((s, k) => (
            <li class="skillchip" style={`animation-delay:${k * 45}ms`}>
              <Icon name="check" />
              {s}
            </li>
          ))}
        </ul>
      </div>
    ))}

    <div class="softhead rv">
      <span class="eyebrow">Soft skills</span>
      <h3>
        How I <span class="hl">work</span>
      </h3>
    </div>
    <ul class="soft">
      {profile.softSkills.map((s, i) => (
        <li class="sc card rv" style={`--d:${i * 0.07}s`}>
          <div class="ic">
            <Icon name={s.icon} />
          </div>
          <h4>{s.title}</h4>
          <p>{s.evidence}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<script>
  const list = document.querySelector<HTMLElement>("[data-tabs]");
  if (list) {
    const tabs = [...list.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panels = tabs.map((t) =>
      document.getElementById(t.getAttribute("aria-controls")!),
    );

    const select = (n: number, focus = false) => {
      tabs.forEach((t, i) => {
        const on = i === n;
        t.setAttribute("aria-selected", String(on));
        t.tabIndex = on ? 0 : -1;
        panels[i]?.toggleAttribute("data-inactive", !on);
      });
      if (focus) tabs[n].focus();
    };

    list.addEventListener("click", (e) => {
      const tab = (e.target as Element).closest<HTMLButtonElement>(
        '[role="tab"]',
      );
      if (tab) select(tabs.indexOf(tab));
    });

    list.addEventListener("keydown", (e) => {
      const i = tabs.indexOf(document.activeElement as HTMLButtonElement);
      if (i < 0) return;
      const last = tabs.length - 1;
      const next =
        e.key === "ArrowRight"
          ? (i + 1) % tabs.length
          : e.key === "ArrowLeft"
            ? (i - 1 + tabs.length) % tabs.length
            : e.key === "Home"
              ? 0
              : e.key === "End"
                ? last
                : null;
      if (next === null) return;
      e.preventDefault();
      select(next, true);
    });
  }
</script>

<style>
  .tabs {
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
    margin-bottom: 28px;
  }

  :global(.js) .tabs {
    display: flex;
  }

  .tabs button {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 0 18px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--card);
    color: var(--ink);
    font: 600 15px var(--font-sans-stack);
    cursor: pointer;
    transition:
      background-color 0.2s,
      border-color 0.2s,
      color 0.2s;
  }

  .tabs button:hover {
    border-color: var(--g);
  }

  .tabs button[aria-selected="true"] {
    border-color: var(--g);
    background: var(--g);
    color: var(--gtxt);
  }

  .tabs button :global(.i) {
    width: 18px;
    height: 18px;
  }

  .panel {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
    gap: 24px;
    padding: clamp(22px, 4vw, 40px);
    border-radius: 24px;
  }

  .panel + .panel {
    margin-top: 16px;
  }

  :global(.js) .panel[data-inactive] {
    display: none;
  }

  .panel h3 {
    margin-bottom: 10px;
    font-size: 24px;
  }

  .panel p {
    color: var(--mute);
  }

  .big {
    display: grid;
    place-items: center;
    width: 72px;
    height: 72px;
    margin-bottom: 18px;
    border-radius: 20px;
    background: var(--g2);
    color: var(--g);
  }

  .big :global(.i) {
    width: 34px;
    height: 34px;
  }

  .cloud,
  .soft {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .cloud {
    display: flex;
    flex-wrap: wrap;
    align-content: flex-start;
    gap: 10px;
  }

  .skillchip {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 16px;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--bg);
    font-weight: 500;
    animation: pop 0.45s both;
  }

  .skillchip :global(.i) {
    width: 16px;
    height: 16px;
    color: var(--g);
  }

  .softhead {
    margin-top: 64px;
    text-align: center;
  }

  .softhead h3 {
    font-size: clamp(22px, 2.6vw, 28px);
  }

  .soft {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 16px;
    margin-top: 28px;
  }

  .sc {
    padding: 22px;
    border-radius: 20px;
    text-align: center;
    transition:
      transform 0.25s,
      border-color 0.25s;
  }

  .sc:hover {
    border-color: var(--g);
    transform: translateY(-6px);
  }

  .ic {
    display: grid;
    place-items: center;
    width: 58px;
    height: 58px;
    margin: 0 auto 14px;
    border-radius: 50%;
    background: var(--g2);
    color: var(--g);
  }

  .ic :global(.i) {
    width: 28px;
    height: 28px;
  }

  .sc h4 {
    margin: 0 0 8px;
    font: 600 17px / 1.2 var(--font-head-stack);
  }

  .sc p {
    margin: 0;
    color: var(--mute);
    font-size: 14px;
  }

  @keyframes pop {
    from {
      opacity: 0;
      transform: translateY(10px) scale(0.96);
    }
  }

  @media (max-width: 1020px) {
    .soft {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 860px) {
    .panel {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 560px) {
    .soft {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
