---
import { profile } from "../data/profile";
import { navLinks } from "../data/site";
import Icon from "./Icon.astro";
import ThemeToggle from "./ThemeToggle.astro";
---

<div class="progress" aria-hidden="true" data-progress></div>
<header class="site-header" data-site-header>
  <nav aria-label="Main">
    <div class="wrap bar">
      <a class="logo" href="#top">
        <b aria-hidden="true">{profile.initials}</b>
        {profile.shortName}
        <span class="sr-only">
          {profile.name.replace(profile.shortName, "")}
        </span>
      </a>

      <ul class="links" data-nav-links>
        {navLinks.map((link) => (
          <li>
            <a href={link.href}>
              <Icon name={link.icon} />
              {link.label}
            </a>
          </li>
        ))}
      </ul>

      <div class="actions">
        <ThemeToggle />
        <a class="btn solid contact" href="#contact">
          Contact me
        </a>
      </div>
    </div>
  </nav>
</header>

<script>
  import { reduceMotion } from "../scripts/motion";

  const root = document.documentElement;
  const header = document.querySelector<HTMLElement>("[data-site-header]")!;
  const bar = document.querySelector<HTMLElement>("[data-nav-links]")!;
  const progress = document.querySelector<HTMLElement>("[data-progress]")!;
  const links = [...bar.querySelectorAll<HTMLAnchorElement>("a")];
  const sections = links.map((a) =>
    document.querySelector<HTMLElement>(a.getAttribute("href")!),
  );

  // Expose the header height so anchor targets clear the sticky header.
  const setHeight = () =>
    root.style.setProperty("--header-h", `${header.offsetHeight}px`);
  new ResizeObserver(setHeight).observe(header);
  setHeight();

  let current = -1;

  const update = () => {
    const max = root.scrollHeight - root.clientHeight;
    progress.style.transform = `scaleX(${max > 0 ? root.scrollTop / max : 0})`;

    // Active tab: the last section whose top has passed just below the header.
    const line = header.offsetHeight + 60;
    let active = 0;
    sections.forEach((s, i) => {
      if (s && s.getBoundingClientRect().top < line) active = i;
    });
    if (active === current) return;
    current = active;

    links.forEach((a, i) => {
      const on = i === active;
      a.classList.toggle("on", on);
      if (on) a.setAttribute("aria-current", "true");
      else a.removeAttribute("aria-current");
    });

    // When the tabs scroll sideways (second row), keep the active one in view.
    const a = links[active];
    if (bar.scrollWidth > bar.clientWidth) {
      bar.scrollTo({
        left: a.offsetLeft - bar.clientWidth / 2 + a.offsetWidth / 2,
        behavior: reduceMotion() ? "auto" : "smooth",
      });
    }
  };

  let queued = false;
  const onScroll = () => {
    if (queued) return;
    queued = true;
    requestAnimationFrame(() => {
      queued = false;
      update();
    });
  };

  addEventListener("scroll", onScroll, { passive: true });
  addEventListener("resize", onScroll, { passive: true });
  update();
</script>

<style>
  .progress {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 60;
    width: 100%;
    height: 3px;
    background: var(--g);
    transform: scaleX(0);
    transform-origin: 0 50%;
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }

  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 16px;
    min-height: 68px;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 9px;
    min-height: 44px;
    margin-inline-end: auto;
    color: var(--ink);
    font: 700 21px var(--font-head-stack);
    text-decoration: none;
  }

  .logo b {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 11px;
    background: var(--g);
    color: var(--gtxt);
    font-size: 15px;
  }

  .links {
    display: flex;
    gap: 4px;
    margin: 0;
    padding: 4px;
    list-style: none;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--bg2);
  }

  .links li {
    flex: none;
  }

  .links a {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    min-height: 44px;
    padding: 0 14px;
    border-radius: 999px;
    color: var(--ink);
    font-size: 14.5px;
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
    transition:
      background-color 0.25s,
      color 0.25s;
  }

  .links a :global(.i) {
    width: 16px;
    height: 16px;
    color: var(--g);
    transition: color 0.25s;
  }

  .links a:hover {
    background: var(--g2);
  }

  .links a.on {
    background: var(--g);
    color: var(--gtxt);
  }

  .links a.on :global(.i) {
    color: var(--gtxt);
  }

  .links a:focus-visible {
    outline-offset: -3px;
  }

  .actions {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .contact {
    padding: 0 18px;
  }

  /*
   * From 1440px the bar uses the full width so name, 8 tabs, toggle and
   * Contact me fit on one row. Below that the tabs move to their own
   * sideways-scrolling second row. Keep in sync with tests/nav.spec.ts.
   */
  @media (min-width: 1440px) {
    .bar {
      max-width: none;
      padding-inline: 24px;
    }

    .links a {
      padding: 0 12px;
    }
  }

  @media (max-width: 1439.98px) {
    .bar {
      padding-block: 8px;
    }

    .links {
      order: 3;
      width: 100%;
      overflow-x: auto;
      scrollbar-width: none;
    }

    .links::-webkit-scrollbar {
      display: none;
    }
  }

  @media (max-width: 400px) {
    .bar {
      column-gap: 8px;
    }

    .logo {
      font-size: 19px;
    }

    .actions {
      gap: 6px;
    }

    .contact {
      padding: 0 14px;
    }
  }
</style>
