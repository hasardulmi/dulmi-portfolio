---
import { profile } from "../data/profile";
import BugButton from "./BugButton.astro";
---

<section id="writing" class="section" aria-labelledby="writing-title">
  <BugButton section="writing" position="bottom:50px;right:10%" />
  <div class="wrap">
    <div class="head rv">
      <span class="eyebrow">Writing</span>
      <h2 id="writing-title">
        I write about <span class="hl">testing</span>
      </h2>
      <p class="sub">Technical articles on Medium.</p>
    </div>
    <ul class="grid4">
      {profile.articles.map((a, i) => (
        <li class="rv" style={`--d:${i * 0.08}s`}>
          <a class="post card" href={a.url}>
            <small>{a.category}</small>
            <h3>{a.title}</h3>
            <span>{a.summary}</span>
            <em>
              Read on Medium <span aria-hidden="true">→</span>
            </em>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .grid4 {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    display: flex;
  }

  .post {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 10px;
    padding: 24px;
    border-radius: 20px;
    color: var(--ink);
    text-decoration: none;
    transition:
      transform 0.25s,
      border-color 0.25s;
  }

  .post:hover {
    border-color: var(--g);
    transform: translateY(-6px);
  }

  small {
    color: var(--g);
    font-size: 13px;
    font-weight: 600;
  }

  .post > span {
    color: var(--mute);
    font-size: 15px;
  }

  em {
    margin-top: auto;
    color: var(--g);
    font-size: 14px;
    font-style: normal;
    font-weight: 600;
  }

  @media (max-width: 1020px) {
    .grid4 {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .grid4 {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
