---
import { profile } from "../data/profile";
import { keyFigures } from "../data/figures";
import Icon from "./Icon.astro";

const { about } = profile;
const figures = keyFigures(profile);
---

<section id="about" class="section" aria-labelledby="about-title">
  <div class="wrap">
    <div class="head rv">
      <span class="eyebrow">About me</span>
      <h2 id="about-title">
        A tester who <span class="hl">asks "what if?"</span>
      </h2>
    </div>

    <div class="about">
      <div class="story card rv">
        <p class="big">{about.lead}</p>
        {about.paragraphs.map((p) => (
          <p>{p}</p>
        ))}
        <div class="cta">
          <a
            class="btn solid"
            href={profile.cvUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            <Icon name="down" />
            Download CV
            <span class="sr-only">{" (PDF, opens in a new tab)"}</span>
          </a>
          <a class="btn" href="#contact">
            Get in touch
          </a>
        </div>
      </div>

      <ul class="facts rv" style="--d:.1s">
        {about.facts.map((f) => (
          <li class:list={["fact card", { on: f.highlight }]}>
            <Icon name={f.icon} />
            <div>
              <small>{f.label}</small>
              {f.value}
            </div>
          </li>
        ))}
      </ul>
    </div>

    <ul class="stats" data-stats>
      {figures.map((f, i) => (
        <li class="stat card rv" style={`--d:${i * 0.08}s`}>
          <b class="tabular" data-count={f.value}>
            {f.value}
          </b>
          <span>{f.label}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .about {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
    gap: 28px;
    align-items: start;
  }

  .story {
    padding: clamp(22px, 3.5vw, 36px);
    border-radius: 22px;
  }

  .story p {
    color: var(--mute);
  }

  .story .big {
    color: var(--ink);
    font: 600 clamp(19px, 2.1vw, 22px) / 1.45 var(--font-head-stack);
  }

  .story .cta {
    margin-top: 18px;
  }

  .facts,
  .stats {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .facts {
    display: grid;
    gap: 10px;
  }

  .fact {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 14px 18px;
    border-radius: 16px;
    transition:
      border-color 0.25s,
      transform 0.25s;
  }

  .fact:hover {
    border-color: var(--g);
    transform: translateX(4px);
  }

  .fact :global(.i) {
    color: var(--g);
  }

  .fact small {
    display: block;
    color: var(--mute);
    font-size: 13px;
  }

  .fact.on {
    border-color: var(--g);
    background: var(--g2);
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
    margin-top: 28px;
  }

  .stat {
    position: relative;
    overflow: hidden;
    padding: 22px;
    border-radius: 18px;
  }

  .stat::after {
    content: "";
    position: absolute;
    right: -30px;
    bottom: -30px;
    width: 90px;
    height: 90px;
    border-radius: 50%;
    background: var(--g2);
  }

  .stat b {
    position: relative;
    z-index: 1;
    display: block;
    color: var(--g);
    font: 800 42px / 1 var(--font-head-stack);
  }

  .stat span {
    position: relative;
    z-index: 1;
    color: var(--mute);
    font-size: 14px;
  }

  @media (max-width: 1020px) {
    .about {
      grid-template-columns: minmax(0, 1fr);
    }

    .stats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .stat b {
      font-size: 34px;
    }
  }
</style>
