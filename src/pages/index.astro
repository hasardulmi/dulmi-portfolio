---
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import About from "../components/About.astro";
import Marquee from "../components/Marquee.astro";
import Skills from "../components/Skills.astro";
import Experience from "../components/Experience.astro";
import Projects from "../components/Projects.astro";
import Process from "../components/Process.astro";
import Education from "../components/Education.astro";
import Writing from "../components/Writing.astro";
import Leadership from "../components/Leadership.astro";
import Contact from "../components/Contact.astro";
import Footer from "../components/Footer.astro";
import BugHunt from "../components/BugHunt.astro";
import { profile } from "../data/profile";

// Section order: CLAUDE.md §6. TODO: Research ("Dark patterns"), once Dulmi provides details.
---

<BaseLayout
  title={`${profile.name} · Junior QA Engineer`}
  description="Junior QA Engineer in Sri Lanka: manual, functional and API testing, RBAC validation and Agile collaboration."
>
  <Nav />
  <main id="main" tabindex="-1">
    <Hero />
    <About />
    <Marquee />
    <Skills />
    <Experience />
    <Projects />
    <Process />
    <Education />
    <Writing />
    <Leadership />
    <Contact />
  </main>
  <Footer />
  <BugHunt />
</BaseLayout>

<style>
  main:focus {
    outline: none;
  }
</style>
